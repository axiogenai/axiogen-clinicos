# =========================================================================
# ClinicOS Production Environment Configuration Template
# Duplicate this file to '.env' and fill in the correct values.
# =========================================================================

# ── Server configuration
PORT=5000
NODE_ENV=production

# ── Authentication Security
# Generate a secure secret using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_here

# ── Database configurations
# Leave blank to use local SQLite database (default: database.sqlite)
# DATABASE_URL=postgresql://user:password@host:port/database

# ── WhatsApp API Gateway Fallback Integration (Optional)
# If using the official Meta WhatsApp Cloud API:
META_PHONE_NUMBER_ID=
META_WHATSAPP_TOKEN=

# ── Groq API Key (Optional, used for AI translations on printouts)
GROQ_API_KEY=
